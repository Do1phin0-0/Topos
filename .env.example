DATABASE_URL=postgresql://topos:topos@localhost:5432/topos
SEC_EDGAR_USER_AGENT=Your Name your-email@example.com
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Optional: Reddit sentiment. Register a free "script" app at
# https://www.reddit.com/prefs/apps to get these. Reddit sentiment is
# skipped entirely (no error) if left blank.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=topos-signal-bot/0.1

# Optional: X/Twitter sentiment. Requires a paid API plan (X's free tier
# has no search access) — get a bearer token from developer.x.com. Skipped
# entirely (no error) if left blank.
TWITTER_BEARER_TOKEN=
